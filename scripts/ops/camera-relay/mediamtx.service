[Unit]
Description=V2X camera MediaMTX server
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/archive

[Service]
Type=simple
User=v2x-camera
Group=v2x-camera
ExecStart=/usr/local/bin/mediamtx /etc/v2x-camera/mediamtx.yml
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/mnt/archive/v2x-camera/recordings

[Install]
WantedBy=multi-user.target
